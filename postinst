#!/bin/sh
set +e

DOMAIN=com.evgeniy558.controlcenter18
P=/var/mobile/Library/Preferences/$DOMAIN.plist
D=/var/jb/usr/bin/defaults
[ -x "$D" ] || D=/usr/bin/defaults
if [ -x "$D" ]; then
    "$D" write "$P" Enabled -bool true
    "$D" write "$P" enabled -bool true
fi
if [ ! -f "$P" ]; then
    cat > "$P" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Enabled</key>
	<true/>
	<key>enabled</key>
	<true/>
</dict>
</plist>
PLIST
    chown mobile:mobile "$P"
    chmod 644 "$P"
fi

# ElleKit prefers /var/jb/usr/lib/TweakInject when that path exists.  It may
# be the MobileSubstrate directory itself, a symlink to it, a symlink to some
# other directory, or a separate directory.  Only the first two cases already
# see our dylib.  Resolve the target and link into it otherwise.
T=/var/jb/usr/lib/TweakInject
M=/var/jb/Library/MobileSubstrate/DynamicLibraries
LOG=/var/mobile/cc18inject.log
{
    echo "CC18 iOS15 install"
    ls -ld "$T" "$M" 2>&1
} > "$LOG" 2>&1
if [ -d "$T" ]; then
    RT=$(cd "$T" 2>/dev/null && pwd -P)
    RM=$(cd "$M" 2>/dev/null && pwd -P)
    echo "T=$RT" >> "$LOG"
    echo "M=$RM" >> "$LOG"
    if [ -n "$RT" ] && [ "$RT" != "$RM" ]; then
        ln -sf "$M/ControlCenter18.dylib" "$T/ControlCenter18.dylib"
        ln -sf "$M/ControlCenter18.plist" "$T/ControlCenter18.plist"
        echo "linked main tweak into TweakInject" >> "$LOG"
    else
        echo "TweakInject already resolves to DynamicLibraries" >> "$LOG"
    fi
else
    echo "TweakInject directory absent; main stays in DynamicLibraries" >> "$LOG"
fi

killall -9 cfprefsd 2>/dev/null
K=/var/jb/usr/bin/killall
[ -x "$K" ] || K=/usr/bin/killall
[ -x "$K" ] || K=killall
"$K" -9 SpringBoard 2>/dev/null
exit 0
